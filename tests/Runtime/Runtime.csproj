<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PluginSource Condition="'$(PluginSource)' == ''">../../src/CustomWeapons</PluginSource>
    <CoreProject Condition="'$(CoreProject)' == ''">../../src/CustomWeapons.Core/CustomWeapons.Core.csproj</CoreProject>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(PluginSource)/HeldModelRefresh.cs')">
    <DefineConstants>$(DefineConstants);HELD_REFRESH</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CoreProject)" />
    <Compile Include="$(PluginSource)/CustomWeaponsPlugin.cs" Link="CustomWeaponsPlugin.cs" />
    <Compile Include="$(PluginSource)/PluginConfig.cs" Link="PluginConfig.cs" />
    <Compile Include="$(PluginSource)/HeldModelRefresh.cs" Link="HeldModelRefresh.cs" Condition="Exists('$(PluginSource)/HeldModelRefresh.cs')" />
    <Compile Include="$(PluginSource)/WeaponState.cs" Link="WeaponState.cs" Condition="Exists('$(PluginSource)/WeaponState.cs')" />
    <EmbeddedResource Include="$(PluginSource)/econ-attribute-names.json" LogicalName="CustomWeapons.econ-attribute-names.json" Condition="Exists('$(PluginSource)/econ-attribute-names.json')" />
  </ItemGroup>
</Project>
